# Local HTTP deployment: http://localhost:8080
FRAMEIT_PORT=8080

# Local development default. Use the existing password if the volume exists.
# For new installations, choose a random alphanumeric password.
FRAMEIT_DB_PASSWORD=frameit-local

# Optional: PDF export works without AI. Never commit real credentials.
FRAMEIT_OPENAI_API_KEY=
FRAMEIT_OPENAI_MODEL=gpt-5.6-luna
FRAMEIT_OPENAI_BASE_URL=https://api.openai.com/v1/

# Optional: required for uploading attachments. Current client uses AWS S3.
# PUBLIC_BASE_URL only controls generated file links, not the upload endpoint.
FRAMEIT_S3_BUCKET=
FRAMEIT_S3_REGION=eu-central-1
FRAMEIT_S3_ACCESS_KEY=
FRAMEIT_S3_SECRET_KEY=
FRAMEIT_S3_PUBLIC_BASE_URL=
